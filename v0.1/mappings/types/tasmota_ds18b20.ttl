# Device type: ESP8266 running Tasmota firmware, with ONE DS18B20 temperature probe.
# REAL format. Sources:
#   message example        https://tasmota.github.io/docs/DS18x20/
#   SetOption8 (C/F), SetOption52 (UTC offset), FullTopic   https://tasmota.github.io/docs/Commands/
#   topics, TelePeriod     https://tasmota.github.io/docs/MQTT/
# Decoder: services/ingestion-gateway/gateway/decoders/tasmota.py
#   Telemetry (every TelePeriod, default 300 s) looks like:
#   {"Time":"2021-01-02T09:09:44","DS18B20":{"Id":"00000566CC39","Temperature":13.3},"TempUnit":"C"}
#
# Things this real format brings that the fake vendors didn't:
#   - Time is LOCAL with no offset -> the binding must give the timezone.
#   - Celsius by default, but switchable to Fahrenheit (SetOption8), and the
#     message says which in "TempUnit" -> the decoder passes it on (step 2f).
#   - A probe is generic: what it measures depends on where it is installed,
#     so the TYPE only says "a temperature"; the BINDING places it on a point.
#   - With several probes the keys become "DS18B20-1", "DS18B20-2", ... ;
#     that would be a different type (or per-field placements).

@prefix dtteo: <urn:dtteo:schema#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix unit:  <http://qudt.org/vocab/unit/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix schema: <http://schema.org/> .
@prefix types: <urn:dtteo:types#> .

types:tasmota_ds18b20 a dtteo:DeviceType ;
    dtteo:version "1.0.0" ;
    dtteo:decoder "tasmota" ;
    dtteo:manufacturerDoc "https://tasmota.github.io/docs/DS18x20/" ;

    dtteo:hasValue [
        dtteo:field "DS18B20.Temperature" ;
        dtteo:pointClass brick:Temperature_Sensor ;   # generic; the binding says which point
        # What the DS18B20 can measure: "-55°C to +125°C" (Analog Devices datasheet,
        # https://wcm-cce.cldnet.analog.com/media/cn/technical-documentation/data-sheets/2812.pdf).
        # Outside this, the reading can't be real -> BAD.
        ssn-system:hasSystemCapability [ ssn-system:hasSystemProperty [
            a ssn-system:MeasurementRange ;
            schema:minValue -55 ; schema:maxValue 125 ; schema:unitCode unit:DEG_C ] ]
    ] .
