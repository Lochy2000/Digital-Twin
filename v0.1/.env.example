# Copy this file to .env (same folder) and change the passwords. .env is git-ignored.
# Letters and digits only: the owner password is also used inside a connection URL.
POSTGRES_PASSWORD=change_me_owner
HISTORIAN_DB_PASSWORD=change_me_historian
GRAFANA_DB_PASSWORD=change_me_grafana
# Grafana's admin login (http://localhost:3000). If left out, it's "admin" and Grafana asks you to change it.
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
# Broker logins (MQTT). Every client must log in; broker/acl.conf says who may do what.
MQTT_GATEWAY_PASSWORD=change_me_mqtt_gateway
MQTT_HISTORIAN_PASSWORD=change_me_mqtt_historian
# Shared by the test devices (Acme, Borealis, the Tasmota test board). Real devices get their own.
MQTT_DEVICE_PASSWORD=change_me_mqtt_device
# Read-only login for watching the broker with mosquitto_sub.
MQTT_ENGINEER_PASSWORD=change_me_mqtt_engineer
