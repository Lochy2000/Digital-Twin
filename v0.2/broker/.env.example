# For running the broker on its own. Copy to .env in this folder; .env is git-ignored.
# The dev setup uses dev/.env instead.
MQTT_GATEWAY_PASSWORD=change_me_mqtt_gateway
MQTT_HISTORIAN_PASSWORD=change_me_mqtt_historian
MQTT_ENGINEER_PASSWORD=change_me_mqtt_engineer       # read-only login for watching with mosquitto_sub
# Device logins: names separated by spaces, all sharing one password for now.
MQTT_DEVICES=digitwin_pi
MQTT_DEVICE_PASSWORD=change_me_mqtt_device
