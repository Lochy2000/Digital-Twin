# For running the platform on its own (the server). Copy to .env in this folder; .env is git-ignored.
# The dev setup uses dev/.env instead. Letters and digits only (the owner password goes in a URL).
POSTGRES_PASSWORD=change_me_owner
HISTORIAN_DB_PASSWORD=change_me_historian
GRAFANA_DB_PASSWORD=change_me_grafana
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
MQTT_HISTORIAN_PASSWORD=change_me_mqtt_historian
# BROKER_HOST=platform-broker        # the default; step E adds that broker
