# For running the gateway on its own (the Pi). Copy to .env in this folder; .env is git-ignored.
# The dev setup uses dev/.env instead.
MQTT_GATEWAY_PASSWORD=change_me_mqtt_gateway
MQTT_HISTORIAN_PASSWORD=change_me_mqtt_historian     # until step E the historian still logs in here
MQTT_DEVICE_PASSWORD=change_me_mqtt_device           # shared by test devices; real devices get their own
MQTT_ENGINEER_PASSWORD=change_me_mqtt_engineer       # read-only login for watching with mosquitto_sub
