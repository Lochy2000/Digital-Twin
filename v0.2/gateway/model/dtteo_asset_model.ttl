# DT-TEO asset model, starting point (v0.1)
# ------------------------------------------------------------------
# One placeholder heat/cool unit serving one HVAC zone.
# Vocabulary: Brick 1.5 (brick:), RealEstateCore (rec:) for spaces,
# Brick ref schema (ref:) for links to stored time series,
# QUDT (unit:) for units.
#
# How to extend:
#   - New sensor on the unit: add a point node and list it under
#     :unit1 brick:hasPoint, then give it a ref:hasExternalReference
#     whose ref:hasTimeseriesId matches the point_id the ingestion
#     gateway publishes.
#   - Real equipment: replace brick:Packaged_Heat_Pump with the class
#     that matches Botanic's unit once it is specified.
#   - Sources:
#       Brick classes and relationships   https://docs.brickschema.org/brick/relationships.html
#                                         https://github.com/BrickSchema/Brick
#       Time-series references            https://docs.brickschema.org/metadata/timeseries-storage.html
#       Units (QUDT), e.g.                https://qudt.org/vocab/unit/DEG_C
#       Validation tool (brickschema)     https://brickschema.readthedocs.io/en/stable/
#   - Expected ranges (dtteo:expectedRange, step 2g): outside them a reading is
#     SUSPECT. The values below are PLACEHOLDERS chosen by us, not from Botanic;
#     replace them with agreed operating limits (see mappings/dtteo_onboarding.ttl).
#   - Value kind (dtteo:valueKind, step 2k): how readings of a point combine over
#     time, so storage can summarise them correctly (see mappings/dtteo_onboarding.ttl):
#       "measurement"  a level that goes up and down (temperature, power)  -> mean/min/max
#       "total"        a running total that only goes up, or resets to 0
#                      (an energy meter's kWh)                              -> last minus first
#       "state"        a word or on/off held until it changes (mode)       -> time in each state
#   - Validate after every change:
#       python -c "import brickschema as b; g=b.Graph(load_brick=True); \
#         g.load_file('dtteo_asset_model.ttl'); print(g.validate()[2])"
# ------------------------------------------------------------------

@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix rec:   <https://w3id.org/rec#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit:  <http://qudt.org/vocab/unit/> .
@prefix schema: <http://schema.org/> .
@prefix dtteo: <urn:dtteo:schema#> .
@prefix :      <urn:dtteo:site1#> .

# --- Spaces -------------------------------------------------------

:site1 a rec:Site ;
    rdfs:label "Test site" ;
    brick:hasPart :building1 .

:building1 a rec:Building ;
    rdfs:label "Test building" ;
    brick:hasPart :room1 .

:room1 a rec:Room ;
    rdfs:label "Room 1" .

:zone1 a rec:HVACZone ;
    rdfs:label "Zone 1" ;
    brick:hasPart :room1 ;
    brick:hasPoint :zone_temp, :zone_setpoint .

# --- Equipment ----------------------------------------------------

:unit1 a brick:Packaged_Heat_Pump ;      # placeholder class
    rdfs:label "Heat/cool unit 1" ;
    brick:feeds :zone1 ;
    brick:hasLocation :room1 ;
    brick:hasPoint :supply_temp, :power, :energy, :mode_cmd, :mode_status, :heat_cmd, :cool_cmd .

:weather1 a brick:Weather_Station ;
    rdfs:label "Weather source (simulated in v0.1)" ;
    brick:hasPoint :outside_temp .

# --- Points: zone ---------------------------------------------------

:zone_temp a brick:Zone_Air_Temperature_Sensor ;
    dtteo:expectedRange [ schema:minValue 5 ; schema:maxValue 35 ; schema:unitCode unit:DEG_C ] ;   # placeholder: an occupied room
    rdfs:label "Zone air temperature" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "unit1.zone_air_temp" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:zone_setpoint a brick:Target_Zone_Air_Temperature_Setpoint ;
    rdfs:label "Zone temperature setpoint" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "unit1.zone_setpoint" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

# --- Points: unit ---------------------------------------------------

:supply_temp a brick:Supply_Air_Temperature_Sensor ;
    dtteo:expectedRange [ schema:minValue 0 ; schema:maxValue 60 ; schema:unitCode unit:DEG_C ] ;   # placeholder: heating and cooling supply air
    rdfs:label "Supply air temperature" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "unit1.supply_air_temp" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:power a brick:Active_Power_Sensor ;
    dtteo:expectedRange [ schema:minValue 0 ; schema:maxValue 10 ; schema:unitCode unit:KiloW ] ;   # placeholder: replace with the unit's rated input power
    rdfs:label "Electrical power" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:KiloW ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "unit1.power" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:energy a brick:Electric_Energy_Sensor ;
    rdfs:label "Electrical energy used (meter total)" ;
    dtteo:valueKind "total" ;          # a meter register: only goes up (or resets), so summaries use last minus first
    brick:hasUnit unit:KiloW-HR ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "unit1.energy" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:mode_cmd a brick:Mode_Command ;
    rdfs:label "Requested operating mode (heat / cool / off)" ;
    dtteo:valueKind "state" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "unit1.mode_cmd" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:mode_status a brick:Mode_Status ;
    rdfs:label "Reported operating mode (heat / cool / off)" ;
    dtteo:valueKind "state" ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "unit1.mode_status" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:heat_cmd a brick:Heating_Command ;
    rdfs:label "Heating output (0-100 %)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:PERCENT ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "unit1.heat_cmd" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:cool_cmd a brick:Cooling_Command ;
    rdfs:label "Cooling output (0-100 %)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:PERCENT ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "unit1.cool_cmd" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

# --- Points: weather ------------------------------------------------

:outside_temp a brick:Outside_Air_Temperature_Sensor ;
    dtteo:expectedRange [ schema:minValue -20 ; schema:maxValue 40 ; schema:unitCode unit:DEG_C ] ;   # placeholder: UK weather
    rdfs:label "Outside air temperature" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "weather1.outside_air_temp" ;   # <equipment>.<point>, like the others (was site1.outside_air_temp)
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

# --- Lab test rig (v0.2 step C) --------------------------------------
# The dt-edge rig on the Pi: whatever object is under test (kettle, fan matrix, ...) plus
# the room it sits in. WHAT each thermocouple or camera spot is fixed to changes per test and
# is kept in dt-edge's asset profiles, not here: here a thermocouple is just "socket 1".
# Expected ranges are PLACEHOLDERS (lab conditions), not agreed limits.
# The camera images themselves are not points (they aren't single values); only the
# summaries and spots are. More camera-derived points (areas, hot-spot position, ...) can be
# added here later as plain points.

:building1 brick:hasPart :lab1 .

:lab1 a rec:Room ;
    rdfs:label "Lab (test rig)" .

:rig1 a brick:Equipment ;
    rdfs:label "Lab test rig: object under test + room" ;
    brick:hasLocation :lab1 ;
    brick:hasPoint :rig_tc_ch1, :rig_tc_ch2, :rig_tc_ch3, :rig_tc_ch4,
        :rig_tc_ch5, :rig_tc_ch6, :rig_tc_ch7, :rig_tc_ch8,
        :rig_tc_cold_junction, :rig_lepton_max, :rig_lepton_mean, :rig_lepton_min,
        :rig_mlx_max, :rig_mlx_mean, :rig_mlx_min, :rig_lepton_spot1,
        :rig_lepton_spot2, :rig_lepton_spot3, :rig_lepton_spot4, :rig_lepton_spot5,
        :rig_lepton_spot6, :rig_lepton_spot7, :rig_lepton_spot8, :rig_room_air_temp,
        :rig_room_humidity, :rig_room_pressure, :rig_plug_power, :rig_plug_energy_today,
        :rig_plug_on .

:rig_tc_ch1 a brick:Temperature_Sensor ;
    rdfs:label "Thermocouple, TC-08 socket 1 (where it is fixed: dt-edge asset profile)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -20 ; schema:maxValue 150 ; schema:unitCode unit:DEG_C ] ;   # placeholder
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "rig1.tc_ch1" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:rig_tc_ch2 a brick:Temperature_Sensor ;
    rdfs:label "Thermocouple, TC-08 socket 2 (where it is fixed: dt-edge asset profile)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -20 ; schema:maxValue 150 ; schema:unitCode unit:DEG_C ] ;   # placeholder
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "rig1.tc_ch2" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:rig_tc_ch3 a brick:Temperature_Sensor ;
    rdfs:label "Thermocouple, TC-08 socket 3 (where it is fixed: dt-edge asset profile)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -20 ; schema:maxValue 150 ; schema:unitCode unit:DEG_C ] ;   # placeholder
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "rig1.tc_ch3" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:rig_tc_ch4 a brick:Temperature_Sensor ;
    rdfs:label "Thermocouple, TC-08 socket 4 (where it is fixed: dt-edge asset profile)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -20 ; schema:maxValue 150 ; schema:unitCode unit:DEG_C ] ;   # placeholder
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "rig1.tc_ch4" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:rig_tc_ch5 a brick:Temperature_Sensor ;
    rdfs:label "Thermocouple, TC-08 socket 5 (where it is fixed: dt-edge asset profile)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -20 ; schema:maxValue 150 ; schema:unitCode unit:DEG_C ] ;   # placeholder
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "rig1.tc_ch5" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:rig_tc_ch6 a brick:Temperature_Sensor ;
    rdfs:label "Thermocouple, TC-08 socket 6 (where it is fixed: dt-edge asset profile)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -20 ; schema:maxValue 150 ; schema:unitCode unit:DEG_C ] ;   # placeholder
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "rig1.tc_ch6" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:rig_tc_ch7 a brick:Temperature_Sensor ;
    rdfs:label "Thermocouple, TC-08 socket 7 (where it is fixed: dt-edge asset profile)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -20 ; schema:maxValue 150 ; schema:unitCode unit:DEG_C ] ;   # placeholder
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "rig1.tc_ch7" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

