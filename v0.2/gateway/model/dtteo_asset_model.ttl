        ref:hasTimeseriesId "rig1.lepton_min" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:rig_mlx_max a brick:Temperature_Sensor ;
    rdfs:label "MLX90640 camera, hottest pixel in view" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -10 ; schema:maxValue 150 ; schema:unitCode unit:DEG_C ] ;   # placeholder
