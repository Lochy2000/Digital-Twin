    rdfs:label "Thermocouple, TC-08 socket 8 (where it is fixed: dt-edge asset profile)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -20 ; schema:maxValue 150 ; schema:unitCode unit:DEG_C ] ;   # placeholder
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "rig1.tc_ch8" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:rig_tc_cold_junction a brick:Temperature_Sensor ;
    rdfs:label "TC-08 logger's own temperature (cold junction)" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -10 ; schema:maxValue 50 ; schema:unitCode unit:DEG_C ] ;   # placeholder
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "rig1.tc_cold_junction" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:rig_lepton_max a brick:Temperature_Sensor ;
    rdfs:label "Lepton 3.5 camera, hottest pixel in view" ;
    dtteo:valueKind "measurement" ;
    brick:hasUnit unit:DEG_C ;
    dtteo:expectedRange [ schema:minValue -10 ; schema:maxValue 150 ; schema:unitCode unit:DEG_C ] ;   # placeholder
    ref:hasExternalReference [
        a ref:TimeseriesReference ;
        ref:hasTimeseriesId "rig1.lepton_max" ;
        ref:storedAt "postgresql://dtteo/telemetry"
    ] .

:rig_lepton_mean a brick:Temperature_Sensor ;
